# ============================================================================
# STREAMKART 3D — ENVIRONMENT VARIABLES (.env)
# ============================================================================

# Kunci rahasia server untuk menandatangani Room ID & Secret Token secara stateless (HMAC-SHA256)
MASTER_KEY="ganti_dengan_kunci_acak_minimal_32_karakter_rahasia"

# Konfigurasi Pusher Channels (Opsional saat dev lokal, wajib saat deploy multi-streamer di Vercel)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap1"

# Ekspos Pusher Key ke Frontend Vite
VITE_PUSHER_KEY=""
VITE_PUSHER_CLUSTER="ap1"
